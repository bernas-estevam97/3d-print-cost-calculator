# dependencies
/node_modules

# build output and caches
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# generated Prisma client (rebuilt by `npm install` / `prisma generate`)
/src/generated/

# secrets: keep only the template
.env*
!.env.example
*.pem

