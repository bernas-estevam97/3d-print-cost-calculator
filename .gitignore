/prisma/*.db
/prisma/*.db-*
/uploads/
/backup/
/logs/
*.log

# editor/agent tooling installed by `prisma init` (not part of the app)
/.claude/
/.agents/
/.windsurf/
skills-lock.json

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# private local notes
NOTES.local.md
